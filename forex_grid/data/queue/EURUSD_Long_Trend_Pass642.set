; Triton v1.0 — Optimization Template
; Thesis: EURUSD Long — Trend Following
; Regime: DXY weakness, SMA50 > SMA200, EUR bid on pullbacks to 1.16-1.17
; Direction: LONG ONLY (fixed)
; Chart TF: M1
; BT: 2025.12.01 – 2026.03.01 | FT: 2026.03.01 – 2026.05.01
; Kill: DXY reclaims 100, or Warsh hawkish June FOMC
;
; PHILOSOPHY: Ranges as close to original ArchangelX as possible.
; Only change: TradeDirection locked LONG. Filter starting values biased
; toward trend regime (EMA on, ADX on, BB off) but optimizer can override.
;
; GENERAL TRADE SETTINGS
AllowNewSequence=true
StrategyDescription=EURUSD Long Trend DXY Weakness May2026
TradeComment=Triton_EURUSD_Long
MagicNumber=1002
UseRandomEntryDelay=false
RandomSeed=42
LogLevel=1
; EA LICENSING SETTINGS
LicenseKey=
; SEQUENCE SETTINGS
ATRPeriod=14
PipStep=15.0
PipStepExponent=1.5
MaxPipStep=0.0
DelayTradeSequence=3
LiveDelay=0
LotMultiplierFirstTradeAfterLD=1.0
CombineLiveDelayTrades=true
TradeDirection=1
MaxOrdersPerDirection=20
ReverseSequenceDirection=false
; MONEY MANAGEMENT SETTINGS
TakeProfit=50.0
StopLoss=0.0
LockProfitMinTrades=0
LockProfit=31.0
LockProfitCheckMode=0
TrailingStop=10.0
TrailingCheckMode=0
AllowSamePairDirectionTrades=false
; COMPOUND SETTINGS
UseCompounding=false
InitialAccountBalanceThreshold=100000.0
RiskPercentForCompounding=1.0
RiskInPips=100.0
MaxLotSizeForCompounding=10.0
; LOTSIZE SETTINGS
LotSize=0.61
RiskPercent=0.0
LotSizeExponent=1.2
MaxLotSize=1.0
; WEEKEND CLOSURE SETTINGS
CloseForWeekend=true
DayToClose=5
TimeToClose=21:00
DayToRestart=1
TimeToRestart=01:00
; TRADING SESSION SETTINGS
TradeCustomTimes=false
TradingSessionMonday=00:00-23:59
TradingSessionTuesday=00:00-23:59
TradingSessionWednesday=00:00-23:59
TradingSessionThursday=00:00-23:59
TradingSessionFriday=00:00-21:00
ActionAtEndOfSession=0
; EQUITY PROTECTOR SETTINGS
MaxRunningLoss=5000.0
RestartEAAfterLoss=0
RestartNextDayAt=01:00
RestartAfterHours=3.0
DailyProfitTarget=1000.0
UltimateTargetBalance=0.0
GlobalEquityStopType=0
GlobalEquityStopValue=0.0
ResetGlobalEquityStop=false
MinSecondsBetweenTrades=0
; RSI SETTINGS — optimizer decides on/off
UseRSI=false
RSITimeframe=1
RSIPeriod=14
RSIOverboughtLevel=60
; EMA SETTINGS — start ON (trend), optimizer can turn off
UseEMA=true
EMATimeframe=30
EMAFast=4
EMAMid=8
EMASlow=60
EMATrendRule=0
DoubleCheckEMAFirstRealTrade=true
; ADX SETTINGS — start ON (trend confirmation), optimizer can turn off
UseADX=true
ADXTimeframe=30
ADXPeriod=14
ADXThreshold=25.0
ADXTrendRule=0
DoubleCheckADXFirstRealTrade=false
; BOLLINGER BANDS SETTINGS — start OFF (trend), optimizer can turn on
UseBollinger=false
BBMode=0
BBTimeframe=30
BBPeriod=20
BBDeviation=1.5
; NEWS FILTER SETTINGS
UseHighImpactNews=true
NewsTradesAction=0
CloseMinutesBeforeNews=60
PauseMinutesAfterNews=60