; Triton v1.0 — Optimization Template
; Thesis: USDJPY Short — Range Ceiling Rejection
; Regime: BoJ intervention caps 160.00, compressed 155-160, bearish rejections at ceiling
; Direction: SHORT ONLY (fixed)
; Chart TF: M1
; BT: 2025.12.01 – 2026.03.01 | FT: 2026.03.01 – 2026.05.01
; Kill: BoJ stands down publicly, or DXY breaks 101+
;
; PHILOSOPHY: Ranges as close to original ArchangelX as possible.
; Only change: TradeDirection locked SHORT. Filter starting values biased
; toward range regime (BB on, EMA off, ADX off) but optimizer can override.
;
; GENERAL TRADE SETTINGS
AllowNewSequence=true
StrategyDescription=USDJPY Short Range Ceiling May2026
TradeComment=Triton_USDJPY_Short
MagicNumber=1003
UseRandomEntryDelay=false
RandomSeed=42
LogLevel=1
; EA LICENSING SETTINGS
LicenseKey=
; SEQUENCE SETTINGS
ATRPeriod=14
PipStep=15.0
PipStepExponent=1.5
MaxPipStep=0.0
DelayTradeSequence=3
LiveDelay=0
LotMultiplierFirstTradeAfterLD=1.0
CombineLiveDelayTrades=true
TradeDirection=2
MaxOrdersPerDirection=20
ReverseSequenceDirection=false
; MONEY MANAGEMENT SETTINGS
TakeProfit=50.0
StopLoss=0.0
LockProfitMinTrades=0
LockProfit=28.0
LockProfitCheckMode=0
TrailingStop=10.0
TrailingCheckMode=0
AllowSamePairDirectionTrades=false
; COMPOUND SETTINGS
